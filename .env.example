# ─── SocialShield Root Environment Configuration Template ───────────────────
# Copy this file to .env and configure for your environment

PORT=5000
JWT_SECRET=your-secret-key-for-jwt-signing

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Legacy MongoDB Atlas Connection (Preserved for validated migration)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/socialshield?retryWrites=true&w=majority

FLASK_ENV=development
