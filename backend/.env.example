# ─── SocialShield Backend Environment Variables Template ─────────────────────
# Rename/Copy to .env and insert your real production or development secrets.

# ── Supabase Project Settings (Required) ──────────────────────────────────────
# Obtain from: Supabase Dashboard → Settings → API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share-client-side
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-jwt-verification
SUPABASE_STORAGE_BUCKET=scan-media

# ── AI Model & External Threat Intelligence APIs ──────────────────────────────
# HuggingFace API Key — powers prithivMLmods/deepfake-detector-model-v1
HUGGINGFACE_API_KEY=your_huggingface_api_token

# Google Safe Browsing API Key (v4)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key

# VirusTotal API Key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ── Server & Runtime Environment ──────────────────────────────────────────────
ENV=development
DEBUG=true
PORT=8000
